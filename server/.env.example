# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL - For Phase 1 / Prompt 5)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# Test database (separate from the real one; tests may wipe tables)
TEST_DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name_test

# UPI payments
UPI_ID=yourname@bank

# Public URL clients use to reach this server
PUBLIC_BASE_URL=http://localhost:5001

# Authentication & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin account (created by the seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Geocoding
NOMINATIM_USER_AGENT=FixItNow-HomeServicesApp/1.0 (your-email@example.com)
GOOGLE_MAPS_API_KEY=your_key_here

# Live tracking
TWO_WHEELER_SPEED_KMH=your_two_wheeler_speed
CAR_SPEED_KMH=your_car_speed
OTHER_SPEED_KMH=your_other_speed