# ==============================================================================
# FixIt Now - Master Environment Variables Example
# Copy to server/.env and client/.env as appropriate
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Client Configuration
VITE_API_URL=http://localhost:5000

# Database Configuration (PostgreSQL - For Phase 1 / Prompt 5)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fixitnow_db
PGUSER=postgres
PGHOST=localhost
PGDATABASE=fixitnow_db
PGPASSWORD=postgres
PGPORT=5432

# Security & Secrets
JWT_SECRET=fixit_now_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Third-Party / Geocoding
NOMINATIM_USER_AGENT=FixItNow-HomeServicesApp/1.0
GOOGLE_MAPS_API_KEY=your_key_here

# Live Tracking Speeds (km/h)
TWO_WHEELER_SPEED_KMH=40
AUTO_SPEED_KMH=30
CAR_SPEED_KMH=35
OTHER_SPEED_KMH=30

