{
  "name": "fixit-now",
  "version": "1.0.0",
  "type": "module",
  "description": "FixIt Now - On-demand home-services marketplace with customer, partner, and admin portals",
  "private": true,
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "db:schema": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:demo": "node db/demo-seed.js",
    "lint": "eslint client/src server/src",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1"
  }
}
